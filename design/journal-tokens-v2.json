  "exceptions": [
    {
      "id": "frame-type-scale",
      "source": "CODEX-TASK-1.md design rules",
      "reason": "YAML lists allowable ratio 1.333 but its reference scale is for UI. Exact rounded editorial sequence 32/44/56/76/100/136/180 is specified by project; ratios after rounding are not mathematically identical."
    },
    {
      "id": "video-safe",
      "source": "CODEX-TASK-1.md / docs/SHOW-RULES.md",
      "reason": "8% top / 15% bottom are project video rules, absent from YAML. Rounded outward to 4u: top 156u instead of 153.6u."
    },
    {
      "id": "canvas-geometry",
      "reason": "Frame margins, box dimensions, line widths and palette are project decisions. Margins/gaps use existing spacing scale; sizes/positions are geometry on 4u grid, not extra spacing steps."
    },
    {
      "id": "sticker-padding",
      "source": "CODEX-TASK-1.md §3",
      "reason": "Project explicitly requires minimum 180u art and 32u padding; overrides YAML card padding 16/24."
    },
    {
      "id": "short-copy",
      "reason": "45–90 character paragraph measure does not apply to short place names, metric labels and dates. Product captions only; no paragraphs."
    },
    {
      "id": "cropping",
      "reason": "Each aspect ratio has separate layout. Central focal object survives center square crop; peripheral caption may be lost. Do not automatically crop landscape to portrait; re-layout."
    },
    {
      "id": "photo-not-supplied",
      "reason": "No verified product photo selected. Gray photo rectangle is a wireframe slot. Photo contrast / gaze / horizon require actual input; caption is on opaque paper below the image."
    },
    {
      "id": "candidate-barbos",
      "reason": "Approved base candidate is resized without structural changes; this is not the final bordered sticker or map marker."
    },
    {
      "id": "material-overlap",
      "reason": "Overlap is physical layering inside a single collage group; it is not a gap between independent information groups. Shadows, torn edges, bindings and tape are decorative."
    },
    {
      "id": "organic-edge",
      "reason": "Paper tears, washes, textile grain and pencil curves are organic decoration; their paths need not follow the layout grid. Text allocations and block origins remain on 4u grid."
    },
    {
      "id": "photo-study",
      "reason": "Photo slot uses the approved Barbos render on a staged material background to show volume, not a travel photo. Marked example; replace with verified user photo for production."
    },
    {
      "id": "stronger-scale",
      "reason": "Uses existing 136/180u editorial steps for pronounced headline/counter hierarchy; no added font-size steps."
    },
    {
      "id": "final-tonal-inversion",
      "reason": "Dark green closing frame puts a bright receipt at the center; intentional tonal inversion rather than arbitrary palette change."
    }
  ],
